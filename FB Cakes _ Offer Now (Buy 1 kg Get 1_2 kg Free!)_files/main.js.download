  chatanswer(chatOptionId) {
    const apiUrl = ` https://uat-ecom.azurewebsites.net/api/Home/Get_Chat?chatOptionId=${chatOptionId}`;
    this.chatbot = this.http.get(apiUrl); // Save to property if needed
