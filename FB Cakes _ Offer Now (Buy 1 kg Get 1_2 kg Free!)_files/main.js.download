    this.onHowerChangeImage = false; // Default False
    this.cartModal = false; // Default False
    this.loader = false;
    this.fdata = [];
    // console.log(this.grids)
  }
  ngOnInit() {
    this.fdata = JSON.parse(localStorage.getItem("fav"));
    if (this.fdata != null) {
      setInterval(() => {
        this.fdata.forEach(y => {
          if (this.ecomproduct.pid === y.pid) {
            this.ecomproduct.fav = true;
          }
        });
      }, 300);
    }
    if (this.loader) {
      setTimeout(() => {
        this.loader = false;
      }, 1000); // Skeleton Loader
    }
  }
  get prodname() {
    return this.ecomproduct?.pname.replace(/\s+/g, '-');
  }
