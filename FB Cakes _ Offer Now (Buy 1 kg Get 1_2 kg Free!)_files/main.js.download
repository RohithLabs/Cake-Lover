    //     item.Lable2 = itemName1.lable1
    //     item.Lable3 = itemName1.lable2
    //     item.Lable4 = itemName1.lable3
    //   });
    //   console.log(this.footer)
    // })
    // this.productService.Categories.subscribe(Cat => {
