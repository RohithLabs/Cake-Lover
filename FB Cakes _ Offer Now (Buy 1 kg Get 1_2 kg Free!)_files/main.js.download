      currency: 'EUR',
      price: 0.90 // price of euro
    }, {
      name: 'Rupees',
      currency: 'INR',
      price: 70.93 // price of inr
    }, {
      name: 'Pound',
      currency: 'GBP',
      price: 0.78 // price of euro
    }, {
      name: 'Dollar',
      currency: 'USD',
      price: 1 // price of usd
    }];
    this.lenData = [];
    this.c_count = 0;
    this.loadgrid = 0;
    this.chathide = false;
    // console.log(this.Cdata)
    // this.productService.cartliveItems.subscribe(response => {
    //   console.log(response)
