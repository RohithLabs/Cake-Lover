class EditprofileComponent {
  constructor(myService,
  // Dependency injection of MyService
  modalService, productService, toastrService, externalservice) {
    this.myService = myService;
    this.modalService = modalService;
    this.productService = productService;
    this.toastrService = toastrService;
    this.externalservice = externalservice;
    this.ref = [];
    this.showpop = false;
    this.ordercount = 0;
    const Name = localStorage.getItem('name');
    // console.log(Name)
    this.userName = Name;
  }
  ngOnInit() {
    this.refcoupon();
    this.myService.useredit.subscribe(data => {
      // console.log(data)
      if (data == true) {
        this.userview = data;
        this.modalService.open(this.UserEdit, {
          centered: true,
          size: 'l'
        });
      }
    });
    this.myService.referral.subscribe(ref => {
      // console.log(ref)
      // console.log(this.showpop)
      if (ref == true) {
        this.userview = ref;
        if (this.showpop == true) {
          this.modalService.open(this.referral, {
            centered: true,
            size: 'l'
          });
        }
        // this.modalService.open(this.referral, { centered: true, size: 'l' });
      }
    });
  }
  savename() {
    localStorage.setItem('name', this.userName);
    this.productService.nameget.subscribe(x => {
      // console.log(x)
      this.myService.name.next(this.userName);
      if (x["status"] == 200) {
        this.toastrService.success(' Name updated Successfully!');
        this.modalService.dismissAll();
      } else {
        this.toastrService.error('Error', ' Please Fill the name!');
      }
      //  localStorage.setItem('name', response["name"]);
    });
  }
  refcoupon() {
    const cusid = localStorage.getItem('customerid');
    this.externalservice.GetRefCoupon(cusid).subscribe(resp => {
      // console.log(resp)
      if (resp['status'] == 200) {
        this.showpop = true;
        const ordcou = resp['orderCount'];
        this.ordercount = Number(ordcou);
        // console.log(this.ordercount)
        //  this.userview = data
        this.ref = resp["refData"][0] || [];
      }
      // console.log(this.ordercount)
    });
  }
  genratereferral() {
    const cusid = localStorage.getItem('customerid');
    this.externalservice.GenerateRefCode(cusid).subscribe(resp => {
      // console.log(resp)
      if (resp.status == 200) {
        this.refcoupon();
      }
    });
  }
  copyToClipboard(code) {
    navigator.clipboard.writeText(code).then(() => {
      this.toastrService.success(' Code Copied Successfully!');
      // this.modalService.dismissAll()
    }).catch(err => {
      // console.error("Failed to copy: ", err);
    });
  }
