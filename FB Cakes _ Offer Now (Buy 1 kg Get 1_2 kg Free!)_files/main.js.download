  validateAlphabeticInput(event) {
    const keyCode = event.keyCode;
    const allowedKeyCodes = [8, 9, 32];
    if (!(keyCode >= 65 && keyCode <= 90 || keyCode >= 97 && keyCode <= 122 || allowedKeyCodes.includes(keyCode))) {
      event.preventDefault();
    }
  }
  getloginData() {
    this.submitted = true;
    if (this.Login.controls.phoneNo.invalid) {
      return true;
    }
    this.isDisabled = true;
    const phoneNumber = this.Login.controls.phoneNo.value;
    // console.log(phoneNumber);
    this.login.phoneno = phoneNumber;
    // console.log('log', this.login.phoneno);
    this.externalService.GetPhoneno(phoneNumber);
    this.externalService._getlogin.subscribe(response => {
      const phoneNumber = response;
      // console.log(phoneNumber);
      this.phoneNo = phoneNumber;
      // console.log('phoneNo', this.phoneNo);
      this.custid = this.phoneNo.custid;
      // console.log('cusid', this.custid);
      // localStorage.setItem('custid', this.custid?.toString());
      // console.log('custid', custid);
      if (this.custid > 0) {
        this.otpshow = true;
        this.logphshow = false;
        this.loginshow = false;
        this.submitted = false;
        const phoneNumber = this.Login.controls.phoneNo.value;
        // console.log(phoneNumber);
        this.mobile = phoneNumber;
        this.externalService.GetOldCustomer(this.custid, phoneNumber, this.test);
        this.externalService._getoldCustomer.subscribe(response => {
          this.oldCus = response;
          // console.log('oldCus', this.oldCus);
          var response = response;
          if (response && response["status"] == 200) {
            //  this.toastrService.success('OTP', ' Otp Send Successfully')
            this.toastrService.success("OTP", response["service"]);
          } else {
            this.toastrService.error("OTP", "Otp Send UnSuccessfully !..");
          }
          this.customerId = this.oldCus.custid;
          // console.log(this.customerId);
        });
        // console.log('Phone number matched. Showing OTP verification section.');
      } else {
        this.loginshow = true;
        this.logphshow = false;
        this.otpshow = false;
        this.submitted = false;
        // console.log('Phone number did not match. Showing login section.');
      }
    });
  }
  getchat() {
