  send() {
    const msgerInput = document.querySelector(".msger-input");
    const msgerChat = document.querySelector(".msger-chat");
    const BOT_MSGS = ["Ohh... I can't understand what you are trying to say. Sorry!"];
    const BOT_IMG = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR-AAD2jIQT0p1MirMajjcczk0yaNbZTFnTwA&s";
    const PERSON_IMG = "https://static.wikia.nocookie.net/fourworldseries/images/c/c8/Hinata_Hyuga.png/revision/latest?cb=20170521160052";
    const BOT_NAME = "Customer Care";
    const PERSON_NAME = localStorage.getItem("name") || "User";
    const msgText = msgerInput.value;
    if (!msgText.trim()) return;
    appendMessage(PERSON_NAME, PERSON_IMG, "right", msgText);
    msgerInput.value = "";
    botResponse(msgText);
    function appendMessage(name, img, side, text) {
      const msgHTML = `
      <div class="msg ${side}-msg" style="flex-direction: ${side === "right" ? "row-reverse" : "row"}; display: flex; align-items: flex-end; margin-bottom: 10px;margin-top:10px">
        <div class="msg-bubble" style="background: ${side === "right" ? "rgb(220 147 147 / 38%)" : "#d7d4d4a3"}; color: #000000; border-bottom-${side === "right" ? "right" : "left"}-radius: 0; max-width: 300px; padding: 15px; border-radius: 15px;margin-top: 10px;">
          <div class="msg-info" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <div class="msg-info-name" style="margin-right: 10px; font-weight: bold;">${name}</div>
            <div class="msg-info-time" style="font-size: 0.85em;">${formatDate(new Date())}</div>
          </div>
          <div class="msg-text" style="word-wrap: break-word">${text}</div>
        </div>
      </div>
    `;
      msgerChat.insertAdjacentHTML("beforeend", msgHTML);
      msgerChat.scrollTop += 500;
    }
    function botResponse(userText) {
      let botReply = BOT_MSGS[random(0, BOT_MSGS.length - 1)];
      const lowerText = userText.toLowerCase();
      if (/open|working hours|business hours/.test(lowerText)) {
        botReply = "We are open daily from 10:00 AM to 9:00 PM, including weekends!";
      } else if (/menu|catalog|list of cakes/.test(lowerText)) {
        botReply = "You can view our cake menu here: https://yourwebsite.com/menu 📋";
      } else if (/eggless|egg free/.test(lowerText)) {
        botReply = "Yes, we have 100% eggless cakes available in all flavors. 🎂🟢";
      } else if (/payment|pay|online|card|upi/.test(lowerText)) {
        botReply = "We accept UPI, card payments, net banking, and cash on delivery.";
      } else if (/delivery charge|fee/.test(lowerText)) {
        botReply = "Delivery charges depend on your location, starting from ₹49. Free delivery above ₹999!";
      } else if (/track|status|where is/.test(lowerText)) {
        botReply = "To track your order, please share your order ID. We'll check it for you.";
      } else if (/phone|contact|number/.test(lowerText)) {
        botReply = "You can reach us at 📞 +91-98765 43210 or via WhatsApp.";
      } else if (/whatsapp/.test(lowerText)) {
        botReply = "Yes! You can place orders and get support via WhatsApp at +91-98765 43210.";
      } else if (/bulk|corporate|party/.test(lowerText)) {
        botReply = "We offer bulk and corporate orders for events and parties. Please contact us for discounts and options.";
      } else if (/offers|discount|deal/.test(lowerText)) {
        botReply = "Check out our latest offers here: https://yourwebsite.com/offers 🎉";
      } else if (/store|shop|outlet/.test(lowerText)) {
        botReply = "Our main outlet is located at Karapakkam, Chennai. We also offer doorstep delivery.";
      } else if (/thanks|thank you/.test(lowerText)) {
        botReply = "You're welcome! 😊 Let us know if you need anything else.";
      }
      setTimeout(() => {
        appendMessage(BOT_NAME, BOT_IMG, "left", botReply);
        const chatArray = JSON.parse(localStorage.getItem("Chat") || "[]");
        chatArray.push({
          id: chatArray.length + 1,
          sender: msgText,
          receiver: botReply,
          sendTime: formatDate(new Date()),
          receiveTime: formatDate(new Date())
        });
        localStorage.setItem("Chat", JSON.stringify(chatArray));
      }, botReply.split(" ").length * 100);
    }
    function formatDate(date) {
      const h = "0" + date.getHours();
      const m = "0" + date.getMinutes();
      return `${h.slice(-2)}:${m.slice(-2)}`;
    }
    function random(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }
  }
  GetOldCustomerLogin() {
    this.mobile = this.login.phoneno;
    // console.log(this.custid, this.mobile);
    this.enterotp = null, this.enterotp1 = null, this.enterotp2 = null, this.enterotp3 = null;
    this.externalService.GetOldCustomer(this.custid, this.mobile, this.test);
    this.externalService._getoldCustomer.subscribe(response => {
      const oldCus = response;
      // console.log(oldCus);
      // this.toastrService.success('OTP', ' Otp Verified Saved Successfully')
      var response = response;
      if (response && response["status"] == 200) {
        //  this.toastrService.success(`${this.mobile} Successfully.`, 'Verification code sent to',)
        this.toastrService.success(`${this.mobile} Successfully.`, response["service"]);
        this.submitted = false;
      } else {
        this.toastrService.error(`${this.mobile} UnSuccessfully.!..`, "Verification code sent to");
      }
    });
  }
  GetNewcusOtp() {
    this.CusOTP = `${this.enterotp}${this.enterotp1}${this.enterotp2}${this.enterotp3}`;
    this.custid = this.customerId;
    this.externalService.GetCustomerOtp(this.custid, this.CusOTP, 12, this.test);
    this.externalService._getCustomerOtp.subscribe(response => {
      if (response["status"] === 200) {
        this.custIdHide = this.custid;
        this.chathisId = 0;
        this.getchat();
        this.otpshow = false;
        this.toastrService.success("OTP", "OTP Verified Successfully");
        // Store user data in local storage
        localStorage.setItem("customerid", this.custid?.toString());
        localStorage.setItem("denglu", "1");
        localStorage.setItem("secid", response["secid"]);
        localStorage.setItem("name", response["name"]);
        this.myService.name.next(response["name"]);
        localStorage.setItem("myApp_CartCount", response["cartcount"]);
        this.myService.cartsource.next(response["cartcount"]);
        const storedValue = localStorage.getItem("mypg");
        const productId = localStorage.getItem("productId");
        const prdname = localStorage.getItem("prdname");
        const chatdata = JSON.parse(localStorage.getItem("chatdetails") || "[]");
        // console.log(chatdata)
        this.details = chatdata;
        // console.log(storedValue, productId, prdname);
        if (storedValue === "2") {
          let cartdata = JSON.parse(localStorage.getItem("Cart") || "[]");
          const customerId = parseInt(localStorage.getItem("customerid") || "0", 10);
          // console.log(cartdata)
          if (cartdata.length > 0) {
            // Assign customer ID to each cart item
            cartdata = cartdata.map(item => ({
              ...item,
              customerid: customerId || null
            }));
            this.productService.SaveCArt(cartdata[0]).subscribe(responsecart => {
              if (responsecart["status"] == 200) {
                // this.router.navigateByUrl('/shop/cart');
                this.toastrService.success("Cart", "Cart Added Successfully");
                // Clear Cart data
                localStorage.removeItem("Cart");
                // Update cart count in local storage
                localStorage.setItem("myApp_CartCount", responsecart.cartcount.toString());
                this.myService.cartsource.next(responsecart.cartcount);
              } else {
                this.toastrService.error("Cart", "Failed to save cart");
              }
            }, error => {
              // console.error("API Error:", error);
              this.toastrService.error("Cart", "An error occurred while saving the cart");
            });
          } else {
            this.router.navigateByUrl(`/shop/product/details/${productId}/${prdname}`);
          }
        } else {
          switch (storedValue) {
            case "0":
              this.router.navigateByUrl("home/cakes");
              break;
            case "1":
              this.router.navigateByUrl("/shop/cakes/collection?category=118");
              break;
            case "3":
              this.router.navigateByUrl("/shop/cart");
              break;
            default:
              this.router.navigateByUrl("home/cakes");
              break;
          }
        }
      } else {
        this.toastrService.error("OTP", "OTP Verification Unsuccessful");
      }
    });
  }
  otpMove(o1, o2, o3, o4, o5) {
    const length = o3.value.length;
    const maxlength = o3.getAttribute("maxlength");
    if (length == maxlength) {
      if (o5 == "") {
        return;
      }
      if (o4 != "") {
        o4.focus();
      }
    }
    if (o1.key == "Backspace") {
      if (o1 != "") {
        o2?.focus();
      }
    }
  }
