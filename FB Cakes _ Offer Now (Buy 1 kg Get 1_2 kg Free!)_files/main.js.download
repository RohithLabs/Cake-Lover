    // console.log(product)
    this.productService.addToWishlist(product);
  }
  addToWishlist(item) {
    // console.log(item);
    let favData = localStorage.getItem("fav") ? JSON.parse(localStorage.getItem("fav")) : [];
    let isPresent = favData.some(el => el.pid === item.pid);
    if (isPresent) {
      favData = favData.filter(el => el.pid !== item.pid);
      localStorage.setItem("fav", JSON.stringify(favData));
      this.toastrService.warning('Removed Favourite', item.pname);
      this.ecomproduct.fav = false; // Fixing the fav property update
    } else {
      favData.push(item);
      localStorage.setItem("fav", JSON.stringify(favData));
      this.toastrService.success('Saved Favourite', item.pname);
      this.ecomproduct.fav = true; // Mark product as favorite
    }
    this.fdata = favData;
  }
