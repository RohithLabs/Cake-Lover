nd-repeat: no-repeat;\n  background-position: center;\n  background-size: cover;\n  border-radius: 50%;\n}\n\n.msg-info[_ngcontent-%COMP%] {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n}\n\n.msg-info-name[_ngcontent-%COMP%] {\n  margin-right: 10px;\n  font-weight: bold;\n}\n\n.msg-info-time[_ngcontent-%COMP%] {\n  font-size: 0.85em;\n}\n\n.msger-inputarea[_ngcontent-%COMP%] {\n  display: flex;\n  padding: 10px;\n  background: #eee;\n}\n\n.msger-inputarea[_ngcontent-%COMP%]   *[_ngcontent-%COMP%] {\n  padding: 10px;\n  border: none;\n  border-radius: 3px;\n  font-size: 1em;\n}\n\n.msger-input[_ngcontent-%COMP%] {\n  flex: 1;\n  background: #ddd;\n}\n\n.msger-send-btn[_ngcontent-%COMP%] {\n  margin-left: 10px;\n  background: orangered;\n  color: #fff;\n  font-weight: bold;\n  cursor: pointer;\n  transition: background 0.23s;\n}\n\n.msger-send-btn[_ngcontent-%COMP%]:hover {\n  background: orangered;\n}\n\n.msger-chat[_ngcontent-%COMP%] {\n  background-color: #fcfcfe;\n  background-size: contain;\n  background-image: url(https://i.ibb.co/wWkwW4D/downloadpng.png);\n}\n\n@media (max-width: 769px) {\n  .hidemobileview[_ngcontent-%COMP%] {\n    display: none;\n  }\n}\n@media (min-width: 768px) {\n  .mobilehide[_ngcontent-%COMP%] {\n    display: none;\n  }\n}\n.chat1-circle-chat1[_ngcontent-%COMP%] {\n  position: fixed;\n  bottom: 70px;\n  height: -webkit-fill-available;\n  z-index: 10000;\n  left: 10px;\n  width: -webkit-fill-available;\n}\n\n.msger1[_ngcontent-%COMP%] {\n  display: flex;\n  flex-flow: column wrap;\n  justify-content: space-between;\n  width: 100%;\n  max-width: 500px;\n  height: -webkit-fill-available;\n  margin: 10px 5px;\n  height: calc(100% - 3px);\n  border: var(--border);\n  border-radius: 5px;\n  background: var(--msger-bg);\n  box-shadow: 0px 3px 16px 0px rgba(0, 0, 0, 0.6), 0 3px 1px -2px rgba(0, 0, 0, 0.2), 0 1px 5px 0 rgba(0, 0, 0, 0.12);\n}\n\n#secretNumber1[_ngcontent-%COMP%] {\n  width: