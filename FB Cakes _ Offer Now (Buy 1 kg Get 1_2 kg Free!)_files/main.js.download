      this.details = this.data.data || this.data;
      // console.log(this.details)
      localStorage.setItem("chatdetails", JSON.stringify(this.details));
      const chatdata = JSON.parse(localStorage.getItem("chatdetails") || "[]");
      // console.log(chatdata)
      this.details = chatdata;
      let storedQues = JSON.parse(localStorage.getItem("chatQUes") || "[]");
      if (storedQues.length > 0) {
        this.chatQues = storedQues;
      }
    });
  }
