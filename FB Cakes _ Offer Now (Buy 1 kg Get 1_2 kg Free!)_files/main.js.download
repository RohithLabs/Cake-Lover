  ngOnInit() {
    const stored = localStorage.getItem("clickedQuestions");
    if (stored) {
      this.clickedQuestionIds = new Set(JSON.parse(stored));
    }
    const logPageId = localStorage.getItem("logPageId");
    // console.log(logPageId);
    this.loginIdpage = Number(logPageId);
    // console.log(this.loginIdpage);
    this.myService.chathistory.subscribe(xadata => {
      // console.log(xadata)
      if (xadata == 1) {
        localStorage.removeItem("chatQA");
        this.chathisId = xadata;
        this.details = [];
        this.chatQA = [];
        this.custIdHide = 0;
      }
    });
    // this.myService.InitialChat.subscribe(chatdata => {
    //   console.log(chatdata)
    //   this.details = chatdata
    // })
    this.currentTime = new Date().toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit"
    });
    const storedQues = JSON.parse(localStorage.getItem("chatQUes") || "[]");
    this.chatQues = storedQues;
    this.custIdHide = parseInt(localStorage.getItem("customerid") || "0", 10) || 0;
    // this.send()
    this.myService.ChatId.subscribe(data => {
      // console.log(data)
      this.IdChat = data;
      // console.log(this.IdChat)
    });
    this.getchat(); // to load questions
    this.loadChatFromStorage();
    // const chatdata = JSON.parse(localStorage.getItem('chatdetails') || '[]');
    // console.log(chatdata)
    // this.details = chatdata
  }
  // @HostListener Decorator
  onWindowScroll() {
    let number = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
    if (number > 600) {
      this.show = true;
    } else {
      this.show = false;
    }
  }
  tapToTop() {
    this.viewScroller.scrollToPosition([0, 0]);
  }
  openchat(id) {
    this.chathide = true;
    this.getchat();
    // this.getanswer(4);
  }
  closechat() {
    this.chathide = false;
    this.IdChat = 0;
  }
